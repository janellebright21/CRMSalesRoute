# Route Planner CRM — Environment Variables
# Copy this file to .env and fill in your Supabase credentials.
# NEVER commit .env to version control.

# Found in: Supabase Dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Found in: Supabase Dashboard → Project Settings → API → anon public key
# This key is safe to expose in client-side code; RLS policies protect your data.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
